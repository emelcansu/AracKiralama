@using AracKiralama.Models

@{
    var filtered = FilteredCars.ToList();
}

<div class="car-list">

    <aside class="filters" aria-label="Araç filtreleri">
        <h2 class="filters-title">Filtrele</h2>

        <div class="filter-group">
            <label for="brandFilter">Marka</label>
            <select id="brandFilter" @bind="selectedBrand">
                <option value="">Tüm Markalar</option>
                @foreach (var brand in Brands)
                {
                    <option value="@brand">@brand</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="categoryFilter">Kategori</label>
            <select id="categoryFilter" @bind="selectedCategory">
                <option value="">Tüm Kategoriler</option>
                @foreach (var category in Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="fuelFilter">Yakıt Türü</label>
            <select id="fuelFilter" @bind="selectedFuel">
                <option value="">Tüm Yakıt Türleri</option>
                @foreach (var fuel in Fuels)
                {
                    <option value="@fuel">@fuel</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="transmissionFilter">Vites</label>
            <select id="transmissionFilter" @bind="selectedTransmission">
                <option value="">Tüm Vites Türleri</option>
                @foreach (var transmission in Transmissions)
                {
                    <option value="@transmission">@transmission</option>
                }
            </select>
        </div>

        <div class="price-row">
            <div class="filter-group">
                <label for="minPrice">En az (TL)</label>
                <input id="minPrice"
                       type="number"
                       min="0"
                       @bind="minPrice"
                       @bind:event="oninput"
                       placeholder="0" />
            </div>

            <div class="filter-group">
                <label for="maxPrice">En çok (TL)</label>
                <input id="maxPrice"
                       type="number"
                       min="0"
                       @bind="maxPrice"
                       @bind:event="oninput"
                       placeholder="Sınırsız" />
            </div>
        </div>

        <button type="button" class="clear-filters" @onclick="ClearFilters">
            Filtreleri Temizle
        </button>
    </aside>

    <section class="results" aria-label="Araç listesi">

        <div class="result-info" aria-live="polite">
            <strong>@filtered.Count</strong> araç listeleniyor
        </div>

        @if (filtered.Count == 0)
        {
            <div class="no-cars">
                Seçilen filtrelere uygun araç bulunamadı.
            </div>
        }
        else
        {
            <div class="car-grid">
                @foreach (var car in filtered)
                {
                    <article class="@CardClass(car)" @key="car.Id">

                        <div class="car-image-container">
                            @if (!string.IsNullOrWhiteSpace(car.ImageUrl))
                            {
                                <img src="@car.ImageUrl"
                                     alt="@CarName(car)"
                                     class="car-image"
                                     onerror="this.style.display='none'" />
                            }

                            <span class="category-badge">@car.Category</span>
                        </div>

                        <div class="car-card-content">
                            <h3>@CarName(car)</h3>

                            <div class="car-details">
                                <span>@car.FuelType</span>
                                <span>@car.Transmission</span>
                                <span>@car.Seats Koltuk</span>
                            </div>

                            @if (!car.IsAvailable)
                            {
                                <p class="unavailable-note">Bu araç şu an kiralamaya uygun değil.</p>
                            }

                            <div class="car-card-bottom">
                                <div class="car-price">
                                    <strong>@car.DailyPrice.ToString("N0") TL</strong>
                                    <span> / gün</span>
                                </div>
                                    <button class="rent-button @(car.IsAvailable ? "" : "unavailable")"
                                             disabled="@(!car.IsAvailable)"
                                               @onclick="() => OnCarSelected.InvokeAsync(car)">
                                                         Kirala
                                                    </button>
                            </div>
                        </div>

                    </article>
                }
            </div>
        }

    </section>

</div>

@code {
    [Parameter]
    public IEnumerable<Car> Cars { get; set; } = new List<Car>();

    [Parameter]
    public EventCallback<Car> OnCarSelected { get; set; }

    private string? selectedBrand;
    private string? selectedCategory;
    private string? selectedFuel;
    private string? selectedTransmission;
    private decimal? minPrice;
    private decimal? maxPrice;

    private IEnumerable<string> Brands => Cars.Select(c => c.Brand).Distinct().OrderBy(b => b);
    private IEnumerable<string> Categories => Cars.Select(c => c.Category).Distinct().OrderBy(c => c);
    private IEnumerable<string> Fuels => Cars.Select(c => c.FuelType).Distinct().OrderBy(f => f);
    private IEnumerable<string> Transmissions => Cars.Select(c => c.Transmission).Distinct().OrderBy(t => t);

    private IEnumerable<Car> FilteredCars => Cars.Where(car =>
        (string.IsNullOrWhiteSpace(selectedBrand) || car.Brand == selectedBrand) &&
        (string.IsNullOrWhiteSpace(selectedCategory) || car.Category == selectedCategory) &&
        (string.IsNullOrWhiteSpace(selectedFuel) || car.FuelType == selectedFuel) &&
        (string.IsNullOrWhiteSpace(selectedTransmission) || car.Transmission == selectedTransmission) &&
        (!minPrice.HasValue || car.DailyPrice >= minPrice.Value) &&
        (!maxPrice.HasValue || car.DailyPrice <= maxPrice.Value)
    );

    private string CardClass(Car car) => car.IsAvailable ? "car-card" : "car-card unavailable";
    private string CarName(Car car) => $"{car.Brand} {car.Model}";

    private void ClearFilters()
    {
        selectedBrand = null;
        selectedCategory = null;
        selectedFuel = null;
        selectedTransmission = null;
        minPrice = null;
        maxPrice = null;
    }
}